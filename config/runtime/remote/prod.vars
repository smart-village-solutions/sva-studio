# Getracktes, nicht-sensitives Remote-Profil. Keine Secrets eintragen.
SVA_RUNTIME_PROFILE=studio
SVA_STACK_NAME=studio
SVA_PUBLIC_BASE_URL=https://studio.smart-village.app
SVA_PARENT_DOMAIN=studio.smart-village.app
SVA_ALLOWED_INSTANCE_IDS=bb-guben,de-musterhausen,bb-bad-belzig,de-studio-sandbox,hb-meinquartier
SVA_AUTH_ISSUER=https://keycloak.smart-village.app/realms/sva-studio
