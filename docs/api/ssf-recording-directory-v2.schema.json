{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ssf-recording-directory-v2.schema.json",
  "title": "SSF live recording directory V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "tenantId",
    "directoryRevision",
    "users"
  ],
  "properties": {
    "contractVersion": {
      "const": "2.0"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "directoryRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "users": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sub",
          "displayName",
          "permissions",
          "languages"
        ],
        "properties": {
          "sub": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,254}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ssf.recording.request",
                "ssf.recording.review",
                "ssf.recording.review.sworn",
                "ssf.recording.supervise",
                "ssf.recording.recovery.custodian"
              ]
            }
          },
          "languages": {
            "type": "array",
            "maxItems": 40,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 35,
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
            }
          }
        }
      }
    }
  }
}
