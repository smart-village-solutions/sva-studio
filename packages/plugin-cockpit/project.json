{
  "name": "plugin-cockpit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/plugin-cockpit/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsc -p packages/plugin-cockpit/tsconfig.lib.json"
      }
    },
    "test:types": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc -p packages/plugin-cockpit/tsconfig.lib.json --noEmit"
      }
    }
  },
  "tags": ["scope:plugin", "type:lib"]
}
