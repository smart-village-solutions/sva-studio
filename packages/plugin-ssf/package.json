{
  "name": "@sva/plugin-ssf",
  "license": "EUPL-1.2",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "plugin.manifest.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./descriptor": {
      "types": "./dist/descriptor.d.ts",
      "default": "./dist/descriptor.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./provisioning": {
      "types": "./dist/provisioning.d.ts",
      "default": "./dist/provisioning.js"
    },
    "./plugin.manifest.json": {
      "default": "./plugin.manifest.json"
    }
  },
  "dependencies": {
    "@sva/plugin-sdk": "workspace:*",
    "@sva/studio-ui-react": "workspace:*",
    "json-canonicalize": "^3.0.0",
    "pg": "^8.22.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^3.23.2",
    "jsdom": "^29.1.0",
    "vitest": "^5.0.3"
  }
}
