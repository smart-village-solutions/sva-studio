{
  "pluginId": "ssf",
  "manifestVersion": 1,
  "extensionTier": "admin",
  "tenantActivationPolicy": "automatic",
  "version": "0.0.1",
  "sdkVersion": "0.0.1",
  "hostCompatibility": {
    "studioVersionRange": "^0.0.1",
    "requiredCapabilities": ["iam", "server", "jobs"]
  },
  "entryPoints": {
    "browser": "./dist/browser.js",
    "server": "./dist/server/index.js",
    "jobs": "./dist/server.js"
  },
  "runtimeRequirements": {
    "jobs": "ssf.authorization-projection"
  }
}
