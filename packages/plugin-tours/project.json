{
  "name": "plugin-tours",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/plugin-tours/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "tsc -p packages/plugin-tours/tsconfig.lib.json" }
    },
    "test:types": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": { "command": "tsc -p packages/plugin-tours/tsconfig.lib.json --noEmit" }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": { "lintFilePatterns": ["packages/plugin-tours/src/**/*.{ts,tsx}"] }
    }
  },
  "tags": ["scope:plugin", "type:lib"]
}
