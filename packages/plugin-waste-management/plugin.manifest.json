{
  "pluginId": "waste-management",
  "manifestVersion": 1,
  "extensionTier": "feature",
  "tenantActivationPolicy": "optional",
  "version": "0.0.1",
  "sdkVersion": "0.0.1",
  "hostCompatibility": {
    "studioVersionRange": "^0.0.1",
    "requiredCapabilities": ["routing", "navigation", "iam", "jobs", "imports", "exports"]
  },
  "entryPoints": {
    "descriptor": "./dist/descriptor.js",
    "browser": "./dist/index.js",
    "server": "./dist/server.js",
    "jobs": "./dist/server-jobs.js"
  },
  "runtimeRequirements": {
    "jobs": "waste-management.operations"
  }
}
